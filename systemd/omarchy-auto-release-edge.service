[Unit]
Description=Auto-release eratosthenes-pkgs for edge mirror
After=network-online.target eratosthenes-check-versions.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'source /root/.eratosthenes/build-credentials && /root/eratosthenes-pkgs/bin/auto-release edge'
Environment=OMARCHY_STATE_DIR=/root/.state
TimeoutStartSec=7200

[Install]
WantedBy=multi-user.target
